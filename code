#include <iostream>
#include <string>

using namespace std;

string boasVindas() {

    cout << "Digite seu nome!\n";

    string nome;
    cin >> nome;

    cout << "Olá " << nome
         << "! Seja bem vinda ao programa de compras de doces!\n";

    return nome;
}

struct Doces {
    string doce;
    double preco;
};

double menu() {

    Doces catalogo[3] = {
        {"Palha Italiana", 8.00},
        {"Brownie", 10.00},
        {"Brigadeiro", 4.00}
    };

    int tamanho = 3;

    cout << "\n--- MENU DE DOCES ---\n";

    for (int i = 0; i < tamanho; i++) {
        cout << i + 1 << ". "
             << catalogo[i].doce
             << " - R$ "
             << catalogo[i].preco
             << "\n";
    }

    cout << "Escolha um doce e adoce o seu dia!\n";

    int escolha;
    double total = 0;

    cin >> escolha;

    if (escolha == 1) {

        cout << "Ótima escolha! Palha Italiana é o doce perfeito para amantes do meio-termo. Nem muito doce, nem muito sem graça.\n";

        cout << "O preço da palha é R$ 8.00!\n";

        total = catalogo[0].preco;
    }

    else if (escolha == 2) {

        cout << "Huuum... Brownie é bom a qualquer hora!\n";

        cout << "O preço do brownie é R$ 10.00!\n";

        total = catalogo[1].preco;
    }

    else if (escolha == 3) {

        cout << "Brigadeiro é BOM DEMAIS!\n";

        cout << "O preço do brigadeiro é R$ 4.00!\n";

        total = catalogo[2].preco;
    }

    else {
        cout << "Opção inválida!\n";
    }

    return total;
}

int main() {

    string nome = boasVindas();

    double total = menu();

    cout << "\nO total da sua compra foi de R$ "
         << total << "\n";

    cout << "Volte sempre, " << nome << "!\n";

    return 0;
}
